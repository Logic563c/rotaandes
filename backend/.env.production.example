# Plantilla sin secretos; no copiar backend/.env local a Railway.
NODE_ENV=production
# PORT lo proporciona Railway; TRUST_PROXY_HOPS solo detrás de su proxy.
TRUST_PROXY_HOPS=1
CORS_ORIGIN=
DATABASE_URL=
# Estos tres valores fijan el destino privado autorizado para esta publicación.
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
JWT_SECRET=
UMBRAL_HELADA_C=2
# Configurar también RAILPACK_NODE_VERSION=24.20.0 en Railway.
RAILPACK_NODE_VERSION=24.20.0
RAILPACK_NODE_NPM_INSTALL=npm ci --include=dev
RAILPACK_NO_SPA=true
# El predeploy requiere Prisma CLI/tsx; no podar dependencias antes de ese paso.
RAILPACK_PRUNE_DEPS=false
