{
  "name": "rotaandes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspaces",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.herramientas.json && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:db": "npm run test:db --workspace backend",
    "test:e2e": "npm run build && playwright test && playwright test --config playwright.integral.config.ts",
    "test:integral": "npm run build && playwright test --config playwright.integral.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:db && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
